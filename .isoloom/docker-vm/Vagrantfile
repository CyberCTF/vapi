  config.vm.provider "libvirt" do |v|
    v.default_prefix = "vapi_"
  end
  config.vm.network "forwarded_port", guest: 80, host: 80, host_ip: "127.0.0.1"
  config.vm.provider "virtualbox" do |v|
    v.name = "vapi · docker"
    v.cpus = 2
    v.memory = 2048
